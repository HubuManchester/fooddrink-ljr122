<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FoodLens.ViewModels"
             xmlns:models="clr-namespace:FoodLens.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="FoodLens.Views.RecipesPage"
             x:DataType="viewmodels:RecipesViewModel"
             Title="{Binding Title}">

    <Grid BackgroundColor="{DynamicResource PageBackgroundColor}"
          RowDefinitions="Auto,Auto,*"
          Padding="10"
          RowSpacing="10">

        <!-- Search Bar -->
        <SearchBar Grid.Row="0"
                   Placeholder="Search recipes..."
                   Text="{Binding SearchText}"
                   SearchCommand="{Binding GetRecipesCommand}"
                   BackgroundColor="{DynamicResource CardBackgroundColor}"
                   TextColor="{DynamicResource TextPrimaryColor}"
                   PlaceholderColor="Gray"
                   SemanticProperties.Hint="Search for recipes by name or description"
                   SemanticProperties.Description="Recipe search box"/>

        <!-- Category Filter -->
        <ScrollView Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="8"
                                   SemanticProperties.Description="Category filter buttons">
                <Button Text="All"
                        Command="{Binding FilterByCategoryCommand}"
                        CommandParameter="All"
                        BackgroundColor="{DynamicResource PrimaryColor}"
                        TextColor="{DynamicResource ButtonTextColor}"
                        CornerRadius="20"
                        Padding="16,8"
                        FontSize="14"
                        SemanticProperties.Hint="Show all recipe categories"/>
                <Button Text="Breakfast"
                        Command="{Binding FilterByCategoryCommand}"
                        CommandParameter="Breakfast"
                        BackgroundColor="{DynamicResource InfoBackgroundColor}"
                        TextColor="{DynamicResource TextPrimaryColor}"
                        CornerRadius="20"
                        Padding="16,8"
                        FontSize="14"
                        SemanticProperties.Hint="Filter to show only breakfast recipes"/>
                <Button Text="Dinner"
                        Command="{Binding FilterByCategoryCommand}"
                        CommandParameter="Dinner"
                        BackgroundColor="{DynamicResource InfoBackgroundColor}"
                        TextColor="{DynamicResource TextPrimaryColor}"
                        CornerRadius="20"
                        Padding="16,8"
                        FontSize="14"
                        SemanticProperties.Hint="Filter to show only dinner recipes"/>
                <Button Text="Dessert"
                        Command="{Binding FilterByCategoryCommand}"
                        CommandParameter="Dessert"
                        BackgroundColor="{DynamicResource InfoBackgroundColor}"
                        TextColor="{DynamicResource TextPrimaryColor}"
                        CornerRadius="20"
                        Padding="16,8"
                        FontSize="14"
                        SemanticProperties.Hint="Filter to show only dessert recipes"/>
                <Button Text="Drinks"
                        Command="{Binding FilterByCategoryCommand}"
                        CommandParameter="Drinks"
                        BackgroundColor="{DynamicResource InfoBackgroundColor}"
                        TextColor="{DynamicResource TextPrimaryColor}"
                        CornerRadius="20"
                        Padding="16,8"
                        FontSize="14"
                        SemanticProperties.Hint="Filter to show only drink recipes"/>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Recipe List with SwipeView -->
        <RefreshView Grid.Row="2"
                     Command="{Binding GetRecipesCommand}"
                     IsRefreshing="{Binding IsBusy, Mode=OneWay}"
                     SemanticProperties.Description="Pull down to refresh the recipe list">

            <CollectionView ItemsSource="{Binding Recipes}"
                            SelectionMode="None"
                            SemanticProperties.Description="List of available recipes">

                <CollectionView.EmptyView>
                    <StackLayout Padding="20"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center">
                        <Label Text="🍽️"
                               FontSize="48"
                               HorizontalOptions="Center"/>
                        <Label Text="No recipes found"
                               FontSize="{DynamicResource FontSizeHeader}"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{DynamicResource TextPrimaryColor}"
                               SemanticProperties.HeadingLevel="Level2"/>
                        <Label Text="Try a different search term or category"
                               FontSize="{DynamicResource FontSizeBody}"
                               HorizontalOptions="Center"
                               TextColor="{DynamicResource TextSecondaryColor}"/>
                    </StackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Recipe">
                        <SwipeView>
                            <SwipeView.LeftItems>
                                <SwipeItems Mode="Execute">
                                    <SwipeItem Text="❤️ Favourite"
                                               BackgroundColor="#E91E63"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:RecipesViewModel}}, Path=SwipeFavouriteCommand}"
                                               CommandParameter="{Binding .}"/>
                                </SwipeItems>
                            </SwipeView.LeftItems>
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Execute">
                                    <SwipeItem Text="📤 Share"
                                               BackgroundColor="#7B1FA2"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:RecipesViewModel}}, Path=ShareRecipeCommand}"
                                               CommandParameter="{Binding .}"/>
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Frame Margin="0,5"
                                   Padding="0"
                                   CornerRadius="12"
                                   HasShadow="True"
                                   BackgroundColor="{DynamicResource CardBackgroundColor}"
                                   BorderColor="{DynamicResource BorderColor}"
                                   SemanticProperties.Description="{Binding Name}">

                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:RecipesViewModel}}, Path=GoToDetailCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Frame.GestureRecognizers>

                                <Grid ColumnDefinitions="120,*"
                                      RowDefinitions="Auto">

                                    <!-- Recipe Image -->
                                    <Grid Grid.Column="0">
                                        <Image Source="{Binding ImageUrl}"
                                               Aspect="AspectFill"
                                               HeightRequest="100"
                                               WidthRequest="120"
                                               IsVisible="{Binding IsImageAvailable}"
                                               SemanticProperties.Description="{Binding Name, StringFormat='Photo of {0}'}"/>

                                        <Frame IsVisible="{Binding IsImageAvailable, Converter={StaticResource InvertedBoolConverter}}"
                                               BackgroundColor="{DynamicResource CardBackgroundColor}"
                                               Padding="8"
                                               CornerRadius="0"
                                               HeightRequest="100"
                                               WidthRequest="120"
                                               BorderColor="Transparent">
                                            <VerticalStackLayout VerticalOptions="Center"
                                                                 HorizontalOptions="Center"
                                                                 Spacing="4">
                                                <Label Text="⚠️"
                                                       FontSize="24"
                                                       HorizontalOptions="Center"/>
                                                <Label Text="Image not available"
                                                       FontSize="10"
                                                       HorizontalTextAlignment="Center"
                                                       TextColor="{DynamicResource ErrorColor}"
                                                       SemanticProperties.Description="Recipe image could not be loaded"/>
                                            </VerticalStackLayout>
                                        </Frame>
                                    </Grid>

                                    <!-- Recipe Info -->
                                    <VerticalStackLayout Grid.Column="1"
                                                         Padding="12,8"
                                                         Spacing="4"
                                                         VerticalOptions="Center">

                                        <Label Text="{Binding Name}"
                                               FontSize="{DynamicResource FontSizeSubtitle}"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource TextPrimaryColor}"
                                               MaxLines="1"
                                               LineBreakMode="TailTruncation"
                                               SemanticProperties.HeadingLevel="Level3"/>

                                        <Label Text="{Binding Description}"
                                               FontSize="{DynamicResource FontSizeCaption}"
                                               TextColor="{DynamicResource TextSecondaryColor}"
                                               MaxLines="2"
                                               LineBreakMode="TailTruncation"/>

                                        <HorizontalStackLayout Spacing="12">
                                            <Label Text="{Binding TotalTimeMinutes, StringFormat='⏱️ {0} min'}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   TextColor="{DynamicResource PrimaryColor}"
                                                   SemanticProperties.Description="{Binding TotalTimeMinutes, StringFormat='Total cooking time {0} minutes'}"/>
                                            <Label Text="{Binding Difficulty, StringFormat='📊 {0}'}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   TextColor="{DynamicResource SecondaryColor}"
                                                   SemanticProperties.Description="{Binding Difficulty, StringFormat='Difficulty level {0}'}"/>
                                            <Label Text="{Binding Category}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   TextColor="{DynamicResource TextSecondaryColor}"/>
                                        </HorizontalStackLayout>

                                        <Label Text="← Swipe to favourite | Share →"
                                               FontSize="10"
                                               TextColor="{DynamicResource TextSecondaryColor}"
                                               IsVisible="{Binding IsFavourite, Converter={StaticResource InvertedBoolConverter}}"/>
                                        <Label Text="❤️ Favourited"
                                               FontSize="10"
                                               TextColor="#E91E63"
                                               IsVisible="{Binding IsFavourite}"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Frame>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Toast Notification Overlay -->
        <Frame Grid.Row="2"
               IsVisible="{Binding IsToastVisible}"
               BackgroundColor="{DynamicResource CardBackgroundColor}"
               CornerRadius="24"
               Padding="16,10"
               HorizontalOptions="Center"
               VerticalOptions="End"
               Margin="0,0,0,80"
               HasShadow="True"
               BorderColor="Transparent"
               SemanticProperties.Description="{Binding ToastMessage}">
            <Label Text="{Binding ToastMessage}"
                   FontSize="{DynamicResource FontSizeBody}"
                   TextColor="{DynamicResource TextPrimaryColor}"
                   HorizontalTextAlignment="Center"/>
        </Frame>

        <!-- Floating Action Button -->
        <Button Grid.Row="2"
                Text="🎲"
                FontSize="24"
                WidthRequest="60"
                HeightRequest="60"
                CornerRadius="30"
                BackgroundColor="{DynamicResource SecondaryColor}"
                TextColor="{DynamicResource ButtonTextColor}"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,16,16"
                Command="{Binding ShakeDiscoverCommand}"
                Shadow="{OnPlatform Default={Shadow Brush=Black, Offset='2,4', Radius=8, Opacity=0.3}}"
                SemanticProperties.Description="Shake to discover a random recipe"
                SemanticProperties.Hint="Tap this button or shake your device to get a random recipe suggestion"/>
    </Grid>

</ContentPage>