<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="FoodLens.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- App-wide colour definitions (WCAG AA 4.5:1 contrast compliant) -->
            <Color x:Key="PrimaryColor">#2E7D32</Color>
            <Color x:Key="PrimaryDarkColor">#1B5E20</Color>
            <Color x:Key="SecondaryColor">#FF6F00</Color>
            <Color x:Key="ErrorColor">#D32F2F</Color>

            <!-- Light Theme Colours -->
            <Color x:Key="BackgroundLight">#FFFFFF</Color>
            <Color x:Key="TextPrimaryLight">#212121</Color>
            <Color x:Key="TextSecondaryLight">#616161</Color>

            <!-- Dark Theme Colours -->
            <Color x:Key="BackgroundDark">#121212</Color>
            <Color x:Key="SurfaceDark">#1E1E1E</Color>
            <Color x:Key="TextPrimaryDark">#FFFFFF</Color>
            <Color x:Key="TextSecondaryDark">#B0B0B0</Color>

            <!-- High Contrast Colours (WCAG AAA 7:1 ratio) -->
            <Color x:Key="HighContrastBackground">#000000</Color>
            <Color x:Key="HighContrastText">#FFFFFF</Color>
            <Color x:Key="HighContrastPrimary">#00E676</Color>
            <Color x:Key="HighContrastBorder">#FFFFFF</Color>

            <!-- Dynamic Font Size Resources (updated at runtime by SettingsViewModel).
                 Using DynamicResource in XAML allows these to change without restarting the app.
                 Base sizes follow WCAG 1.4.4 Resize Text — scalable up to 200%. -->
            <x:Double x:Key="FontSizeCaption">12</x:Double>
            <x:Double x:Key="FontSizeBody">14</x:Double>
            <x:Double x:Key="FontSizeSubtitle">16</x:Double>
            <x:Double x:Key="FontSizeHeader">18</x:Double>
            <x:Double x:Key="FontSizeTitle">24</x:Double>
            <x:Double x:Key="FontSizePageTitle">26</x:Double>

            <!-- Value Converters -->
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
            <toolkit:IsStringNotNullOrEmptyConverter x:Key="IsStringNotNullOrEmptyConverter"/>

        </ResourceDictionary>
    </Application.Resources>
</Application>