<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FoodLens.ViewModels"
             x:Class="FoodLens.Views.CameraPage"
             x:DataType="viewmodels:CameraViewModel"
             Title="{Binding Title}">

    <Grid BackgroundColor="{DynamicResource PageBackgroundColor}">
        <ScrollView>
            <VerticalStackLayout Spacing="16" Padding="20">

                <!-- Page Header -->
                <Label Text="Food Scanner"
                       FontSize="{DynamicResource FontSizePageTitle}"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{DynamicResource TextPrimaryColor}"
                       SemanticProperties.HeadingLevel="Level1"
                       SemanticProperties.Description="Food Scanner page. Take a photo of food to identify it and get nutrition data from the internet."/>

                <Label Text="Take a photo of any food item and our AI will identify it, then fetch real nutritional data from the Open Food Facts API."
                       FontSize="{DynamicResource FontSizeBody}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       TextColor="{DynamicResource TextSecondaryColor}"
                       SemanticProperties.Description="Instructions for using the food scanner with networking"/>

                <!-- Camera Buttons -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,12">

                    <Button Grid.Column="0"
                            Text="📷 Take Photo"
                            Command="{Binding TakePhotoCommand}"
                            BackgroundColor="{DynamicResource PrimaryColor}"
                            TextColor="{DynamicResource ButtonTextColor}"
                            FontSize="15"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="50"
                            IsEnabled="{Binding IsNotBusy}"
                            SemanticProperties.Description="Take a photo using your device camera"
                            SemanticProperties.Hint="Opens the camera to capture a food photo"/>

                    <Button Grid.Column="1"
                            Text="🖼️ Pick Photo"
                            Command="{Binding PickPhotoCommand}"
                            BackgroundColor="{DynamicResource SecondaryColor}"
                            TextColor="{DynamicResource ButtonTextColor}"
                            FontSize="15"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="50"
                            IsEnabled="{Binding IsNotBusy}"
                            SemanticProperties.Description="Select a photo from your gallery"
                            SemanticProperties.Hint="Opens your photo gallery to select a food image"/>
                </Grid>

                <!-- Manual Nutrition Search (NETWORKING FEATURE — user-initiated API call) -->
                <Frame Padding="16"
                       CornerRadius="12"
                       BackgroundColor="{DynamicResource InfoBackgroundColor}"
                       BorderColor="Transparent">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="🔍 Search Nutrition (Network API)"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimaryColor}"
                               SemanticProperties.HeadingLevel="Level2"/>
                        <Label Text="Type a food name to fetch real nutrition data from the Open Food Facts API over the internet."
                               FontSize="{DynamicResource FontSizeCaption}"
                               TextColor="{DynamicResource TextSecondaryColor}"
                               SemanticProperties.Description="Enter a food name to search the nutrition API"/>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Entry Grid.Column="0"
                                   Placeholder="e.g. pizza, banana, chocolate..."
                                   Keyboard="Text"
                                   Text="{Binding SearchFoodName}"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   BackgroundColor="{DynamicResource CardBackgroundColor}"
                                   PlaceholderColor="Gray"
                                   SemanticProperties.Description="Enter food name to search nutrition API"
                                   SemanticProperties.Hint="Type a food name like pizza or banana"/>
                            <Button Grid.Column="1"
                                    Text="🌐 Search"
                                    Command="{Binding SearchNutritionCommand}"
                                    BackgroundColor="{DynamicResource PrimaryColor}"
                                    TextColor="{DynamicResource ButtonTextColor}"
                                    CornerRadius="10"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    Padding="16,10"
                                    IsEnabled="{Binding IsNotBusy}"
                                    SemanticProperties.Description="Search the Open Food Facts API for nutrition data"
                                    SemanticProperties.Hint="Tap to fetch nutrition information from the internet"/>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Loading Indicator (shows during API call) -->
                <VerticalStackLayout IsVisible="{Binding IsLoadingNutrition}"
                                     Spacing="8"
                                     HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsLoadingNutrition}"
                                       Color="{DynamicResource PrimaryColor}"
                                       HeightRequest="40"
                                       SemanticProperties.Description="Loading indicator, fetching nutrition data from API"/>
                    <Label Text="Fetching data from Open Food Facts API..."
                           FontSize="{DynamicResource FontSizeCaption}"
                           HorizontalOptions="Center"
                           TextColor="{DynamicResource TextSecondaryColor}"/>
                </VerticalStackLayout>

                <!-- General Loading Indicator -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{DynamicResource PrimaryColor}"
                                   HeightRequest="40"
                                   SemanticProperties.Description="Loading indicator, analysing your photo"/>

                <!-- Network Error Message -->
                <Frame Padding="12"
                       CornerRadius="10"
                       BackgroundColor="{DynamicResource CardBackgroundColor}"
                       BorderColor="{DynamicResource ErrorColor}"
                       IsVisible="{Binding NetworkErrorMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}">
                    <Label Text="{Binding NetworkErrorMessage}"
                           FontSize="{DynamicResource FontSizeCaption}"
                           TextColor="{DynamicResource ErrorColor}"
                           SemanticProperties.Description="{Binding NetworkErrorMessage}"/>
                </Frame>

                <!-- Captured Image Display -->
                <Frame Padding="0"
                       CornerRadius="16"
                       HasShadow="True"
                       IsClippedToBounds="True"
                       IsVisible="{Binding HasPhoto}"
                       HeightRequest="250"
                       BackgroundColor="{DynamicResource CardBackgroundColor}">
                    <Image Source="{Binding CapturedImage}"
                           Aspect="AspectFill"
                           HeightRequest="250"
                           SemanticProperties.Description="Your captured food photo"/>
                </Frame>

                <!-- Identification Results -->
                <Frame Padding="16"
                       CornerRadius="12"
                       BackgroundColor="{DynamicResource InfoBackgroundColor}"
                       BorderColor="Transparent"
                       IsVisible="{Binding HasPhoto}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding IdentificationResult}"
                               FontSize="{DynamicResource FontSizeHeader}"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimaryColor}"
                               SemanticProperties.HeadingLevel="Level2"
                               SemanticProperties.Description="{Binding IdentificationResult}"/>

                        <Label Text="{Binding ConfidenceText}"
                               FontSize="{DynamicResource FontSizeBody}"
                               TextColor="{DynamicResource PrimaryColor}"
                               IsVisible="{Binding ConfidenceText, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                               SemanticProperties.Description="{Binding ConfidenceText}"/>

                        <Label Text="{Binding NutritionEstimate}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               TextColor="{DynamicResource TextPrimaryColor}"
                               IsVisible="{Binding NutritionEstimate, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                               SemanticProperties.Description="Nutritional information for the identified food"/>

                        <!-- Data Source Indicator (shows whether data came from API or local) -->
                        <Frame Padding="8"
                               CornerRadius="8"
                               BackgroundColor="{DynamicResource CardBackgroundColor}"
                               BorderColor="Transparent"
                               IsVisible="{Binding DataSourceText, Converter={StaticResource IsStringNotNullOrEmptyConverter}}">
                            <Label Text="{Binding DataSourceText}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   FontAttributes="Italic"
                                   TextColor="{DynamicResource PrimaryColor}"
                                   SemanticProperties.Description="{Binding DataSourceText}"/>
                        </Frame>
                    </VerticalStackLayout>
                </Frame>

                <!-- Reset Button -->
                <Button Text="🔄 Scan Another"
                        Command="{Binding ResetScannerCommand}"
                        BackgroundColor="{DynamicResource MutedButtonBackgroundColor}"
                        TextColor="{DynamicResource MutedButtonTextColor}"
                        CornerRadius="12"
                        FontSize="14"
                        IsVisible="{Binding HasPhoto}"
                        HeightRequest="44"
                        SemanticProperties.Description="Reset the scanner to take another photo"
                        SemanticProperties.Hint="Clears the current result and allows you to scan again"/>

                <!-- Placeholder when no photo taken -->
                <VerticalStackLayout IsVisible="{Binding HasPhoto, Converter={StaticResource InvertedBoolConverter}}"
                                     Spacing="8"
                                     Padding="20"
                                     VerticalOptions="Center">
                    <Label Text="📸"
                           FontSize="64"
                           HorizontalOptions="Center"/>
                    <Label Text="{Binding IdentificationResult}"
                           FontSize="{DynamicResource FontSizeSubtitle}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           TextColor="{DynamicResource TextSecondaryColor}"
                           SemanticProperties.Description="Instruction to take a photo"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>