<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FoodLens.ViewModels"
             x:Class="FoodLens.Views.SettingsPage"
             x:DataType="viewmodels:SettingsViewModel"
             Title="{Binding Title}">

    <!-- Workaround: ContentPage.BackgroundColor with DynamicResource has a known MAUI bug.
         Using a full-page Grid with BackgroundColor instead ensures runtime colour updates work. -->
    <Grid BackgroundColor="{DynamicResource PageBackgroundColor}">
        <ScrollView>
            <VerticalStackLayout Spacing="16" Padding="20">

                <!-- Page Header -->
                <Label Text="Settings"
                       FontSize="{DynamicResource FontSizePageTitle}"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimaryColor}"
                       SemanticProperties.HeadingLevel="Level1"
                       SemanticProperties.Description="Settings page for customising the application"/>

                <!-- Appearance Section -->
                <Frame Padding="16"
                       CornerRadius="12"
                       BackgroundColor="{DynamicResource CardBackgroundColor}"
                       BorderColor="{DynamicResource BorderColor}">
                    <VerticalStackLayout Spacing="12">

                        <Label Text="Appearance"
                               FontSize="{DynamicResource FontSizeHeader}"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimaryColor}"
                               SemanticProperties.HeadingLevel="Level2"/>

                        <!-- Dark Mode Toggle -->
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="Dark Mode"
                                       FontSize="{DynamicResource FontSizeSubtitle}"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                       SemanticProperties.Description="Toggle dark mode on or off"/>
                                <Label Text="Reduces eye strain in low light conditions"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       TextColor="{DynamicResource TextSecondaryColor}"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding IsDarkMode}"
                                    OnColor="{DynamicResource PrimaryColor}"
                                    SemanticProperties.Description="Dark mode switch"
                                    SemanticProperties.Hint="Toggle to enable or disable dark mode"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{DynamicResource BorderColor}"/>

                        <!-- High Contrast Toggle -->
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="High Contrast"
                                       FontSize="{DynamicResource FontSizeSubtitle}"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                       SemanticProperties.Description="Toggle high contrast mode"/>
                                <Label Text="Increases colour contrast for better visibility (WCAG AAA 7:1)"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       TextColor="{DynamicResource TextSecondaryColor}"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding IsHighContrast}"
                                    OnColor="{DynamicResource SecondaryColor}"
                                    SemanticProperties.Description="High contrast switch"
                                    SemanticProperties.Hint="Toggle to enable or disable high contrast mode"/>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Font Size Section (WCAG 1.4.4 Resize Text) -->
                <Frame Padding="16"
                       CornerRadius="12"
                       BackgroundColor="{DynamicResource CardBackgroundColor}"
                       BorderColor="{DynamicResource BorderColor}">
                    <VerticalStackLayout Spacing="12">

                        <Label Text="Text Size"
                               FontSize="{DynamicResource FontSizeHeader}"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimaryColor}"
                               SemanticProperties.HeadingLevel="Level2"/>

                        <Label Text="{Binding FontSizeLabel}"
                               FontSize="{DynamicResource FontSizeBody}"
                               TextColor="{DynamicResource TextSecondaryColor}"
                               SemanticProperties.Description="{Binding FontSizeLabel}"/>

                        <!-- Font Size Controls -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Button Grid.Column="0"
                                    Text="A-"
                                    FontSize="18"
                                    Command="{Binding DecreaseFontSizeCommand}"
                                    BackgroundColor="{DynamicResource MutedButtonBackgroundColor}"
                                    TextColor="{DynamicResource MutedButtonTextColor}"
                                    CornerRadius="10"
                                    HeightRequest="48"
                                    SemanticProperties.Description="Decrease font size"
                                    SemanticProperties.Hint="Tap to make text smaller"/>
                            <Button Grid.Column="1"
                                    Text="A+"
                                    FontSize="18"
                                    Command="{Binding IncreaseFontSizeCommand}"
                                    BackgroundColor="{DynamicResource PrimaryColor}"
                                    TextColor="{DynamicResource ButtonTextColor}"
                                    CornerRadius="10"
                                    HeightRequest="48"
                                    SemanticProperties.Description="Increase font size"
                                    SemanticProperties.Hint="Tap to make text larger"/>
                        </Grid>

                        <!-- Preview Text — updates in real time via DynamicResource -->
                        <Frame Padding="12"
                               CornerRadius="8"
                               BackgroundColor="{DynamicResource InfoBackgroundColor}"
                               BorderColor="Transparent">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Preview: This is how text will appear in the app."
                                       FontSize="{DynamicResource FontSizeBody}"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                       SemanticProperties.Description="Text size preview"/>
                                <Label Text="Smaller caption text example"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       TextColor="{DynamicResource TextSecondaryColor}"/>
                                <Label Text="Larger header text example"
                                       FontSize="{DynamicResource FontSizeHeader}"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimaryColor}"/>
                            </VerticalStackLayout>
                        </Frame>
                    </VerticalStackLayout>
                </Frame>

                <!-- Accessibility Info Section -->
                <Frame Padding="16"
                       CornerRadius="12"
                       BackgroundColor="{DynamicResource InfoBackgroundColor}"
                       BorderColor="Transparent">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Accessibility Features"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimaryColor}"
                               SemanticProperties.HeadingLevel="Level2"/>
                        <Label Text="This app follows WCAG 2.1 guidelines:"
                               FontSize="{DynamicResource FontSizeCaption}"
                               TextColor="{DynamicResource InfoTextColor}"/>
                        <Label Text="• Screen reader support (SemanticProperties)"
                               FontSize="{DynamicResource FontSizeCaption}"
                               TextColor="{DynamicResource InfoTextColor}"/>
                        <Label Text="• Adjustable text size (WCAG 1.4.4 — scales 75% to 200%)"
                               FontSize="{DynamicResource FontSizeCaption}"
                               TextColor="{DynamicResource InfoTextColor}"/>
                        <Label Text="• Dark mode for reduced eye strain"
                               FontSize="{DynamicResource FontSizeCaption}"
                               TextColor="{DynamicResource InfoTextColor}"/>
                        <Label Text="• High contrast mode (WCAG 1.4.6 — 7:1 ratio)"
                               FontSize="{DynamicResource FontSizeCaption}"
                               TextColor="{DynamicResource InfoTextColor}"/>
                        <Label Text="• Text-to-speech for recipe steps"
                               FontSize="{DynamicResource FontSizeCaption}"
                               TextColor="{DynamicResource InfoTextColor}"/>
                        <Label Text="• Consistent navigation and layout (WCAG 3.2.3)"
                               FontSize="{DynamicResource FontSizeCaption}"
                               TextColor="{DynamicResource InfoTextColor}"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Reset Button -->
                <Button Text="Reset All Settings"
                        Command="{Binding ResetSettingsCommand}"
                        BackgroundColor="{DynamicResource ErrorColor}"
                        TextColor="White"
                        CornerRadius="12"
                        FontSize="15"
                        HeightRequest="48"
                        Margin="0,8"
                        SemanticProperties.Description="Reset all settings to default values"
                        SemanticProperties.Hint="Resets dark mode, font size, and high contrast to defaults"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>