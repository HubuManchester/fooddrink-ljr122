<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FoodLens.ViewModels"
             x:Class="FoodLens.Views.CompassPage"
             x:DataType="viewmodels:CompassViewModel"
             Title="{Binding Title}">

    <Grid BackgroundColor="{DynamicResource PageBackgroundColor}">
        <ScrollView>
            <VerticalStackLayout Spacing="16" Padding="20">

                <!-- Page Header -->
                <Label Text="🧭 Food Compass"
                       FontSize="{DynamicResource FontSizePageTitle}"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{DynamicResource TextPrimaryColor}"
                       SemanticProperties.HeadingLevel="Level1"
                       SemanticProperties.Description="Food Compass page. Uses the magnetometer sensor to show direction."/>

                <Label Text="Point your device towards the origin of your favourite recipe! Uses the magnetometer hardware sensor."
                       FontSize="{DynamicResource FontSizeBody}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       TextColor="{DynamicResource TextSecondaryColor}"
                       SemanticProperties.Description="Instructions for using the compass feature"/>

                <!-- Compass Display -->
                <Frame Padding="24"
                       CornerRadius="16"
                       BackgroundColor="{DynamicResource InfoBackgroundColor}"
                       BorderColor="Transparent"
                       HorizontalOptions="Center">
                    <VerticalStackLayout Spacing="16" HorizontalOptions="Center">

                        <!-- Compass Needle Visual -->
                        <Grid WidthRequest="200" HeightRequest="200" HorizontalOptions="Center">
                            <!-- Compass background circle -->
                            <Ellipse WidthRequest="200"
                                     HeightRequest="200"
                                     Fill="{DynamicResource InfoBackgroundColor}"
                                     Stroke="{DynamicResource PrimaryColor}"
                                     StrokeThickness="3"/>

                            <!-- Cardinal direction labels -->
                            <Label Text="N"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource ErrorColor}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Start"
                                   Margin="0,10,0,0"/>
                            <Label Text="S"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="End"
                                   Margin="0,0,0,10"/>
                            <Label Text="E"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center"
                                   Margin="0,0,10,0"/>
                            <Label Text="W"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Center"
                                   Margin="10,0,0,0"/>

                            <!-- Compass needle (rotates based on heading) -->
                            <Label Text="⬆"
                                   FontSize="60"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   TextColor="{DynamicResource ErrorColor}"
                                   Rotation="{Binding NeedleRotation}"
                                   SemanticProperties.Description="Compass needle pointing towards magnetic north"/>
                        </Grid>

                        <!-- Heading Display -->
                        <Label Text="{Binding HeadingText}"
                               FontSize="36"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{DynamicResource TextPrimaryColor}"
                               SemanticProperties.Description="{Binding HeadingText}"/>

                        <Label Text="{Binding CardinalDirection}"
                               FontSize="{DynamicResource FontSizeHeader}"
                               HorizontalOptions="Center"
                               TextColor="{DynamicResource PrimaryColor}"
                               SemanticProperties.Description="{Binding CardinalDirection, StringFormat='Currently facing {0}'}"/>

                    </VerticalStackLayout>
                </Frame>

                <!-- Status Message -->
                <Label Text="{Binding StatusMessage}"
                       FontSize="{DynamicResource FontSizeBody}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       TextColor="{DynamicResource TextSecondaryColor}"
                       SemanticProperties.Description="{Binding StatusMessage}"/>

                <!-- Toggle Buttons -->
                <Button Text="🧭 Start Compass"
                        Command="{Binding ToggleCompassCommand}"
                        BackgroundColor="{DynamicResource PrimaryColor}"
                        TextColor="{DynamicResource ButtonTextColor}"
                        FontSize="{DynamicResource FontSizeSubtitle}"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="52"
                        IsVisible="{Binding IsMonitoring, Converter={StaticResource InvertedBoolConverter}}"
                        SemanticProperties.Description="Start the compass magnetometer sensor"
                        SemanticProperties.Hint="Tap to begin reading the compass sensor"/>

                <Button Text="⏹️ Stop Compass"
                        Command="{Binding ToggleCompassCommand}"
                        BackgroundColor="{DynamicResource ErrorColor}"
                        TextColor="{DynamicResource ButtonTextColor}"
                        FontSize="{DynamicResource FontSizeSubtitle}"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="52"
                        IsVisible="{Binding IsMonitoring}"
                        SemanticProperties.Description="Stop the compass magnetometer sensor"
                        SemanticProperties.Hint="Tap to stop reading the compass sensor"/>

                <!-- Emulator Instructions -->
                <Frame Padding="16"
                       CornerRadius="12"
                       BackgroundColor="{DynamicResource CardBackgroundColor}"
                       BorderColor="{DynamicResource BorderColor}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="📱 Emulator Demo Instructions"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimaryColor}"
                               SemanticProperties.HeadingLevel="Level2"/>
                        <Label Text="1. Open the emulator's Extended Controls (three dots '...' button)."
                               FontSize="{DynamicResource FontSizeCaption}"
                               TextColor="{DynamicResource TextPrimaryColor}"/>
                        <Label Text="2. Navigate to 'Virtual Sensors' tab."
                               FontSize="{DynamicResource FontSizeCaption}"
                               TextColor="{DynamicResource TextPrimaryColor}"/>
                        <Label Text="3. Rotate the 3D device model or adjust the Yaw slider."
                               FontSize="{DynamicResource FontSizeCaption}"
                               TextColor="{DynamicResource TextPrimaryColor}"/>
                        <Label Text="4. Watch the compass heading update in real time on this page."
                               FontSize="{DynamicResource FontSizeCaption}"
                               TextColor="{DynamicResource TextPrimaryColor}"/>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>