<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="FoodLens.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Semantic Colour Keys — these are the ONLY colours XAML pages should reference.
                 They are updated at runtime by App.ApplyColours() based on the current
                 combination of theme (Light/Dark) and high contrast (on/off). -->
            <Color x:Key="PageBackgroundColor">#FFFFFF</Color>
            <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
            <Color x:Key="TextPrimaryColor">#212121</Color>
            <Color x:Key="TextSecondaryColor">#616161</Color>
            <Color x:Key="BorderColor">#E0E0E0</Color>
            <Color x:Key="PrimaryColor">#2E7D32</Color>
            <Color x:Key="PrimaryDarkColor">#1B5E20</Color>
            <Color x:Key="SecondaryColor">#FF6F00</Color>
            <Color x:Key="ErrorColor">#D32F2F</Color>
            <Color x:Key="InfoBackgroundColor">#E8F5E9</Color>
            <Color x:Key="InfoTextColor">#424242</Color>
            <Color x:Key="ButtonTextColor">#FFFFFF</Color>
            <Color x:Key="MutedButtonBackgroundColor">#E0E0E0</Color>
            <Color x:Key="MutedButtonTextColor">#212121</Color>

            <!-- Dynamic Font Size Resources (WCAG 1.4.4 Resize Text).
                 Updated at runtime by App.ApplyFontSize(). -->
            <x:Double x:Key="FontSizeCaption">12</x:Double>
            <x:Double x:Key="FontSizeBody">14</x:Double>
            <x:Double x:Key="FontSizeSubtitle">16</x:Double>
            <x:Double x:Key="FontSizeHeader">18</x:Double>
            <x:Double x:Key="FontSizeTitle">24</x:Double>
            <x:Double x:Key="FontSizePageTitle">26</x:Double>

            <!-- Value Converters -->
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
            <toolkit:IsStringNotNullOrEmptyConverter x:Key="IsStringNotNullOrEmptyConverter"/>

        </ResourceDictionary>
    </Application.Resources>
</Application>