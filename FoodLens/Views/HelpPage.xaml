<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodLens.Views.HelpPage"
             Title="Help">

    <Grid BackgroundColor="{DynamicResource PageBackgroundColor}">
        <ScrollView>
            <VerticalStackLayout Spacing="16" Padding="20">

                <Label Text="❓ Help and User Guide"
                       FontSize="{DynamicResource FontSizePageTitle}"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimaryColor}"
                       SemanticProperties.HeadingLevel="Level1"
                       SemanticProperties.Description="Help page providing instructions on how to use the FoodLens application"/>

                <Label Text="Welcome to FoodLens! Here is everything you need to know about using this app."
                       FontSize="{DynamicResource FontSizeBody}"
                       TextColor="{DynamicResource TextSecondaryColor}"/>

                <Frame Padding="16" CornerRadius="12"
                       BackgroundColor="{DynamicResource CardBackgroundColor}"
                       BorderColor="{DynamicResource BorderColor}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="🚀 Getting Started"
                               FontSize="{DynamicResource FontSizeHeader}"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimaryColor}"
                               SemanticProperties.HeadingLevel="Level2"/>
                        <Label Text="FoodLens is a recipe discovery app that helps you find, explore, and cook delicious meals from around the world. Browse recipes by category, scan food with your camera, use the compass to point towards recipe origins, or shake your device to discover something new."
                               FontSize="{DynamicResource FontSizeBody}"
                               TextColor="{DynamicResource TextPrimaryColor}"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame Padding="16" CornerRadius="12"
                       BackgroundColor="{DynamicResource CardBackgroundColor}"
                       BorderColor="{DynamicResource BorderColor}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="🍽️ Browsing Recipes"
                               FontSize="{DynamicResource FontSizeHeader}"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimaryColor}"
                               SemanticProperties.HeadingLevel="Level2"/>
                        <Label Text="• Use the search bar at the top to find recipes by name or description."
                               FontSize="{DynamicResource FontSizeBody}"
                               TextColor="{DynamicResource TextPrimaryColor}"/>
                        <Label Text="• Tap category buttons (All, Breakfast, Dinner, Dessert, Drinks) to filter recipes."
                               FontSize="{DynamicResource FontSizeBody}"
                               TextColor="{DynamicResource TextPrimaryColor}"/>
                        <Label Text="• Tap any recipe card to view full details including ingredients and steps."
                               FontSize="{DynamicResource FontSizeBody}"
                               TextColor="{DynamicResource TextPrimaryColor}"/>
                        <Label Text="• Pull down on the recipe list to refresh."
                               FontSize="{DynamicResource FontSizeBody}"
                               TextColor="{DynamicResource TextPrimaryColor}"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame Padding="16" CornerRadius="12"
                       BackgroundColor="{DynamicResource CardBackgroundColor}"
                       BorderColor="{DynamicResource BorderColor}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="🎲 Shake to Discover"
                               FontSize="{DynamicResource FontSizeHeader}"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimaryColor}"
                               SemanticProperties.HeadingLevel="Level2"/>
                        <Label Text="Cannot decide what to cook? Simply shake your device while on the Recipes page and a random recipe will be suggested! You can also tap the dice button in the bottom-right corner."
                               FontSize="{DynamicResource FontSizeBody}"
                               TextColor="{DynamicResource TextPrimaryColor}"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame Padding="16" CornerRadius="12"
                       BackgroundColor="{DynamicResource CardBackgroundColor}"
                       BorderColor="{DynamicResource BorderColor}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="📷 Food Scanner and Nutrition API"
                               FontSize="{DynamicResource FontSizeHeader}"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimaryColor}"
                               SemanticProperties.HeadingLevel="Level2"/>
                        <Label Text="Use your device camera to take a photo of any food item. The app will attempt to identify the food and then fetch real nutritional data from the Open Food Facts API over the internet. You can also pick an existing photo from your gallery."
                               FontSize="{DynamicResource FontSizeBody}"
                               TextColor="{DynamicResource TextPrimaryColor}"/>
                        <Label Text="You can also manually search for any food by typing its name in the search box on the Scanner page. This sends a live HTTP request to the Open Food Facts REST API and displays the nutritional breakdown."
                               FontSize="{DynamicResource FontSizeBody}"
                               TextColor="{DynamicResource TextPrimaryColor}"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame Padding="16" CornerRadius="12"
                       BackgroundColor="{DynamicResource CardBackgroundColor}"
                       BorderColor="{DynamicResource BorderColor}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="🧭 Food Compass"
                               FontSize="{DynamicResource FontSizeHeader}"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimaryColor}"
                               SemanticProperties.HeadingLevel="Level2"/>
                        <Label Text="The Compass page uses your device's magnetometer (compass sensor) to display your current heading direction in real time. Point your device towards the origin of your favourite recipe!"
                               FontSize="{DynamicResource FontSizeBody}"
                               TextColor="{DynamicResource TextPrimaryColor}"/>
                        <Label Text="On an Android emulator, you can test this by opening Extended Controls (the three dots '...' button), navigating to Virtual Sensors, and rotating the 3D device model or adjusting the Yaw slider. The compass heading will update live on screen."
                               FontSize="{DynamicResource FontSizeBody}"
                               TextColor="{DynamicResource TextPrimaryColor}"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame Padding="16" CornerRadius="12"
                       BackgroundColor="{DynamicResource CardBackgroundColor}"
                       BorderColor="{DynamicResource BorderColor}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="🔊 Read Aloud"
                               FontSize="{DynamicResource FontSizeHeader}"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimaryColor}"
                               SemanticProperties.HeadingLevel="Level2"/>
                        <Label Text="On any recipe detail page, tap the 'Read Steps Aloud' button to have the recipe steps read to you using text-to-speech. This is useful when your hands are busy cooking! Tap again to stop."
                               FontSize="{DynamicResource FontSizeBody}"
                               TextColor="{DynamicResource TextPrimaryColor}"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame Padding="16" CornerRadius="12"
                       BackgroundColor="{DynamicResource CardBackgroundColor}"
                       BorderColor="{DynamicResource BorderColor}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="🗺️ Food Map"
                               FontSize="{DynamicResource FontSizeHeader}"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimaryColor}"
                               SemanticProperties.HeadingLevel="Level2"/>
                        <Label Text="The Food Map page shows where each recipe originates from. Tap the map icon next to any recipe to open it in your device's map application. You can also get your current GPS location."
                               FontSize="{DynamicResource FontSizeBody}"
                               TextColor="{DynamicResource TextPrimaryColor}"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame Padding="16" CornerRadius="12"
                       BackgroundColor="{DynamicResource InfoBackgroundColor}"
                       BorderColor="Transparent">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="🌐 Networking (Open Food Facts API)"
                               FontSize="{DynamicResource FontSizeHeader}"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimaryColor}"
                               SemanticProperties.HeadingLevel="Level2"/>
                        <Label Text="This app connects to the Open Food Facts REST API to fetch real nutritional data for identified foods. When you scan a food item or search manually, the app sends an HTTP GET request to the API and displays the response."
                               FontSize="{DynamicResource FontSizeBody}"
                               TextColor="{DynamicResource TextPrimaryColor}"/>
                        <Label Text="The networking feature demonstrates: HTTP requests, JSON deserialisation, error handling for network failures, and user-visible feedback showing the data source (API vs local)."
                               FontSize="{DynamicResource FontSizeBody}"
                               TextColor="{DynamicResource TextPrimaryColor}"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame Padding="16" CornerRadius="12"
                       BackgroundColor="{DynamicResource InfoBackgroundColor}"
                       BorderColor="Transparent">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="♿ Accessibility"
                               FontSize="{DynamicResource FontSizeHeader}"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimaryColor}"
                               SemanticProperties.HeadingLevel="Level2"/>
                        <Label Text="FoodLens is designed with accessibility in mind following WCAG 2.1 guidelines:"
                               FontSize="{DynamicResource FontSizeBody}"
                               TextColor="{DynamicResource TextPrimaryColor}"/>
                        <Label Text="• Screen Reader Support: All elements have semantic descriptions for TalkBack/VoiceOver."
                               FontSize="{DynamicResource FontSizeCaption}"
                               TextColor="{DynamicResource TextPrimaryColor}"/>
                        <Label Text="• Text Resizing: Adjust font size in Settings from 75% to 200% (WCAG 1.4.4)."
                               FontSize="{DynamicResource FontSizeCaption}"
                               TextColor="{DynamicResource TextPrimaryColor}"/>
                        <Label Text="• Dark Mode: Reduce eye strain in low-light environments."
                               FontSize="{DynamicResource FontSizeCaption}"
                               TextColor="{DynamicResource TextPrimaryColor}"/>
                        <Label Text="• High Contrast Mode: Exceeds WCAG AAA 7:1 contrast ratio (WCAG 1.4.6)."
                               FontSize="{DynamicResource FontSizeCaption}"
                               TextColor="{DynamicResource TextPrimaryColor}"/>
                        <Label Text="• Colour Contrast: All text meets WCAG AA 4.5:1 contrast ratio (WCAG 1.4.3)."
                               FontSize="{DynamicResource FontSizeCaption}"
                               TextColor="{DynamicResource TextPrimaryColor}"/>
                        <Label Text="• Text-to-Speech: Have recipes read aloud for hands-free cooking."
                               FontSize="{DynamicResource FontSizeCaption}"
                               TextColor="{DynamicResource TextPrimaryColor}"/>
                        <Label Text="• Consistent Navigation: Predictable tab-based layout across all pages (WCAG 3.2.3)."
                               FontSize="{DynamicResource FontSizeCaption}"
                               TextColor="{DynamicResource TextPrimaryColor}"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame Padding="16" CornerRadius="12"
                       BackgroundColor="{DynamicResource CardBackgroundColor}"
                       BorderColor="{DynamicResource BorderColor}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="📱 Hardware Features Used"
                               FontSize="{DynamicResource FontSizeHeader}"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimaryColor}"
                               SemanticProperties.HeadingLevel="Level2"/>
                        <Label Text="1. Camera — Food photo capture and identification"
                               FontSize="{DynamicResource FontSizeCaption}"
                               TextColor="{DynamicResource TextPrimaryColor}"/>
                        <Label Text="2. Compass/Magnetometer — Real-time heading direction display"
                               FontSize="{DynamicResource FontSizeCaption}"
                               TextColor="{DynamicResource TextPrimaryColor}"/>
                        <Label Text="3. Text-to-Speech — Read recipe steps aloud"
                               FontSize="{DynamicResource FontSizeCaption}"
                               TextColor="{DynamicResource TextPrimaryColor}"/>
                        <Label Text="4. Accelerometer (Shake) — Shake to discover random recipe"
                               FontSize="{DynamicResource FontSizeCaption}"
                               TextColor="{DynamicResource TextPrimaryColor}"/>
                        <Label Text="5. Geolocation/GPS — Get current location and show recipe origins"
                               FontSize="{DynamicResource FontSizeCaption}"
                               TextColor="{DynamicResource TextPrimaryColor}"/>
                        <Label Text="6. Haptic Feedback — Tactile response on interactions"
                               FontSize="{DynamicResource FontSizeCaption}"
                               TextColor="{DynamicResource TextPrimaryColor}"/>
                        <Label Text="7. Vibration — Confirmation feedback for actions"
                               FontSize="{DynamicResource FontSizeCaption}"
                               TextColor="{DynamicResource TextPrimaryColor}"/>
                    </VerticalStackLayout>
                </Frame>

                <Label Text="FoodLens v1.0.0 | Built with .NET MAUI"
                       FontSize="{DynamicResource FontSizeCaption}"
                       HorizontalOptions="Center"
                       TextColor="{DynamicResource TextSecondaryColor}"
                       Margin="0,12"
                       SemanticProperties.Description="App version information"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>