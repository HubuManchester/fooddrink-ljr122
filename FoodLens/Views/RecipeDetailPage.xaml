<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FoodLens.ViewModels"
             x:Class="FoodLens.Views.RecipeDetailPage"
             x:DataType="viewmodels:RecipeDetailViewModel"
             Title="{Binding Recipe.Name}">

    <Grid BackgroundColor="{DynamicResource PageBackgroundColor}">
        <ScrollView>
            <VerticalStackLayout Spacing="12" Padding="16">

                <!-- Recipe Image with Pinch-to-Zoom -->
                <Frame Padding="0"
                       CornerRadius="16"
                       HasShadow="True"
                       IsClippedToBounds="True"
                       HeightRequest="220"
                       IsVisible="{Binding Recipe.IsImageAvailable}"
                       SemanticProperties.Description="{Binding Recipe.Name, StringFormat='Photo of {0}. Pinch to zoom in or out.'}">
                    <Image x:Name="RecipeImage"
                           Source="{Binding Recipe.ImageUrl}"
                           Aspect="AspectFill"
                           HeightRequest="220">
                        <Image.GestureRecognizers>
                            <PinchGestureRecognizer PinchUpdated="OnPinchUpdated"/>
                        </Image.GestureRecognizers>
                    </Image>
                </Frame>

                <Label Text="📌 Pinch the image to zoom in/out"
                       FontSize="11"
                       HorizontalOptions="Center"
                       IsVisible="{Binding Recipe.IsImageAvailable}"
                       TextColor="{DynamicResource TextSecondaryColor}"
                       SemanticProperties.Description="Hint: you can pinch the recipe image to zoom in or out"/>

                <!-- Image Error Message -->
                <Frame Padding="16"
                       CornerRadius="12"
                       BackgroundColor="{DynamicResource CardBackgroundColor}"
                       BorderColor="{DynamicResource ErrorColor}"
                       IsVisible="{Binding Recipe.IsImageAvailable, Converter={StaticResource InvertedBoolConverter}}">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="⚠️"
                               FontSize="40"
                               HorizontalOptions="Center"/>
                        <Label Text="Image Could Not Be Loaded"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{DynamicResource ErrorColor}"
                               SemanticProperties.HeadingLevel="Level3"/>
                        <Label Text="{Binding Recipe.ImageErrorMessage}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               HorizontalTextAlignment="Center"
                               TextColor="{DynamicResource ErrorColor}"
                               SemanticProperties.Description="Warning: recipe image could not be loaded. This may be due to a missing resource."/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Recipe Title and Origin -->
                <Label Text="{Binding Recipe.Name}"
                       FontSize="{DynamicResource FontSizeTitle}"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimaryColor}"
                       SemanticProperties.HeadingLevel="Level1"
                       SemanticProperties.Description="{Binding Recipe.Name}"/>

                <Label Text="{Binding Recipe.Origin, StringFormat='📍 Origin: {0}'}"
                       FontSize="{DynamicResource FontSizeBody}"
                       TextColor="{DynamicResource PrimaryColor}"
                       SemanticProperties.Description="{Binding Recipe.Origin, StringFormat='Recipe originates from {0}'}"/>

                <!-- Quick Info Cards -->
                <Grid ColumnDefinitions="*,*,*,*"
                      ColumnSpacing="8"
                      Margin="0,8">

                    <Frame Grid.Column="0" Padding="8" CornerRadius="10"
                           BackgroundColor="{DynamicResource InfoBackgroundColor}"
                           BorderColor="Transparent">
                        <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="⏱️" FontSize="20" HorizontalOptions="Center"/>
                            <Label Text="{Binding Recipe.PrepTimeMinutes, StringFormat='{0}m'}"
                                   FontSize="{DynamicResource FontSizeCaption}" HorizontalOptions="Center"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   SemanticProperties.Description="{Binding Recipe.PrepTimeMinutes, StringFormat='Preparation time {0} minutes'}"/>
                            <Label Text="Prep" FontSize="10" HorizontalOptions="Center"
                                   TextColor="{DynamicResource TextSecondaryColor}"/>
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Column="1" Padding="8" CornerRadius="10"
                           BackgroundColor="{DynamicResource InfoBackgroundColor}"
                           BorderColor="Transparent">
                        <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="🔥" FontSize="20" HorizontalOptions="Center"/>
                            <Label Text="{Binding Recipe.CookTimeMinutes, StringFormat='{0}m'}"
                                   FontSize="{DynamicResource FontSizeCaption}" HorizontalOptions="Center"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   SemanticProperties.Description="{Binding Recipe.CookTimeMinutes, StringFormat='Cooking time {0} minutes'}"/>
                            <Label Text="Cook" FontSize="10" HorizontalOptions="Center"
                                   TextColor="{DynamicResource TextSecondaryColor}"/>
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Column="2" Padding="8" CornerRadius="10"
                           BackgroundColor="{DynamicResource InfoBackgroundColor}"
                           BorderColor="Transparent">
                        <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="🍽️" FontSize="20" HorizontalOptions="Center"/>
                            <Label Text="{Binding Recipe.Servings, StringFormat='{0}'}"
                                   FontSize="{DynamicResource FontSizeCaption}" HorizontalOptions="Center"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   SemanticProperties.Description="{Binding Recipe.Servings, StringFormat='Serves {0} people'}"/>
                            <Label Text="Serves" FontSize="10" HorizontalOptions="Center"
                                   TextColor="{DynamicResource TextSecondaryColor}"/>
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Column="3" Padding="8" CornerRadius="10"
                           BackgroundColor="{DynamicResource InfoBackgroundColor}"
                           BorderColor="Transparent">
                        <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="📊" FontSize="20" HorizontalOptions="Center"/>
                            <Label Text="{Binding Recipe.Difficulty}"
                                   FontSize="{DynamicResource FontSizeCaption}" HorizontalOptions="Center"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   SemanticProperties.Description="{Binding Recipe.Difficulty, StringFormat='Difficulty level is {0}'}"/>
                            <Label Text="Level" FontSize="10" HorizontalOptions="Center"
                                   TextColor="{DynamicResource TextSecondaryColor}"/>
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <!-- Description -->
                <Label Text="{Binding Recipe.Description}"
                       FontSize="{DynamicResource FontSizeSubtitle}"
                       TextColor="{DynamicResource TextSecondaryColor}"
                       Margin="0,4"/>

                <!-- Action Buttons Row -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,8">

                    <Button Grid.Column="0"
                            Text="{Binding SpeakButtonText}"
                            Command="{Binding ToggleSpeakStepsCommand}"
                            BackgroundColor="{DynamicResource PrimaryColor}"
                            TextColor="{DynamicResource ButtonTextColor}"
                            CornerRadius="10"
                            FontSize="12"
                            Padding="8,12"
                            SemanticProperties.Description="Read recipe steps aloud using text to speech"
                            SemanticProperties.Hint="Tap to hear the recipe steps read aloud"/>

                    <Button Grid.Column="1"
                            Text="🗺️ Origin Map"
                            Command="{Binding OpenMapCommand}"
                            BackgroundColor="{DynamicResource SecondaryColor}"
                            TextColor="{DynamicResource ButtonTextColor}"
                            CornerRadius="10"
                            FontSize="12"
                            Padding="8,12"
                            SemanticProperties.Description="Open map showing recipe origin location"
                            SemanticProperties.Hint="Tap to see where this recipe comes from on a map"/>

                    <Button Grid.Column="2"
                            Text="📤 Share"
                            Command="{Binding ShareRecipeCommand}"
                            BackgroundColor="#7B1FA2"
                            TextColor="{DynamicResource ButtonTextColor}"
                            CornerRadius="10"
                            FontSize="12"
                            Padding="8,12"
                            SemanticProperties.Description="Share this recipe with others"
                            SemanticProperties.Hint="Tap to share this recipe via messaging or social media"/>
                </Grid>

                <!-- Shopping List Section -->
                <Frame Padding="16"
                       CornerRadius="12"
                       BackgroundColor="{DynamicResource CardBackgroundColor}"
                       BorderColor="{DynamicResource BorderColor}"
                       Margin="0,4">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="🛒 Add Ingredients to Shopping List"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimaryColor}"
                               SemanticProperties.HeadingLevel="Level2"/>

                        <Label Text="Enter the number of servings to calculate ingredient quantities."
                               FontSize="{DynamicResource FontSizeCaption}"
                               TextColor="{DynamicResource TextSecondaryColor}"/>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Entry Grid.Column="0"
                                   x:Name="ServingsEntry"
                                   Placeholder="Number of servings (1-20)"
                                   Keyboard="Numeric"
                                   Text="{Binding ShoppingServingsInput}"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   BackgroundColor="{DynamicResource CardBackgroundColor}"
                                   PlaceholderColor="Gray"
                                   SemanticProperties.Description="Enter number of servings for shopping list"
                                   SemanticProperties.Hint="Type a number between 1 and 20"/>
                            <Button Grid.Column="1"
                                    Text="🛒 Add"
                                    Command="{Binding AddToShoppingListCommand}"
                                    BackgroundColor="{DynamicResource PrimaryColor}"
                                    TextColor="{DynamicResource ButtonTextColor}"
                                    CornerRadius="10"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    Padding="16,10"
                                    SemanticProperties.Description="Add ingredients to shopping list"
                                    SemanticProperties.Hint="Tap to add all ingredients to your shopping list"/>
                        </Grid>

                        <!-- Validation Error Message -->
                        <Label Text="{Binding ShoppingValidationMessage}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               TextColor="{DynamicResource ErrorColor}"
                               IsVisible="{Binding ShoppingValidationMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                               SemanticProperties.Description="{Binding ShoppingValidationMessage}"/>

                        <!-- Success Message -->
                        <Frame Padding="10"
                               CornerRadius="8"
                               BackgroundColor="{DynamicResource InfoBackgroundColor}"
                               BorderColor="Transparent"
                               IsVisible="{Binding ShoppingSuccessMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}">
                            <Label Text="{Binding ShoppingSuccessMessage}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   TextColor="{DynamicResource PrimaryColor}"
                                   SemanticProperties.Description="{Binding ShoppingSuccessMessage}"/>
                        </Frame>
                    </VerticalStackLayout>
                </Frame>

                <!-- Nutrition Info Section -->
                <Frame Padding="12"
                       CornerRadius="12"
                       BackgroundColor="{DynamicResource CardBackgroundColor}"
                       BorderColor="Transparent"
                       Margin="0,4">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Nutrition (per serving)"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimaryColor}"
                               SemanticProperties.HeadingLevel="Level2"/>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="8">
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="{Binding Recipe.Nutrition.Calories, StringFormat='🔥 Calories: {0} kcal'}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   TextColor="{DynamicResource TextPrimaryColor}"/>
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding Recipe.Nutrition.ProteinGrams, StringFormat='💪 Protein: {0:F1}g'}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   TextColor="{DynamicResource TextPrimaryColor}"/>
                            <Label Grid.Row="1" Grid.Column="0"
                                   Text="{Binding Recipe.Nutrition.CarbsGrams, StringFormat='🌾 Carbs: {0:F1}g'}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   TextColor="{DynamicResource TextPrimaryColor}"/>
                            <Label Grid.Row="1" Grid.Column="1"
                                   Text="{Binding Recipe.Nutrition.FatGrams, StringFormat='🧈 Fat: {0:F1}g'}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   TextColor="{DynamicResource TextPrimaryColor}"/>
                            <Label Grid.Row="2" Grid.Column="0"
                                   Text="{Binding Recipe.Nutrition.FiberGrams, StringFormat='🥬 Fiber: {0:F1}g'}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   TextColor="{DynamicResource TextPrimaryColor}"/>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Ingredients Section -->
                <Label Text="Ingredients"
                       FontSize="{DynamicResource FontSizeHeader}"
                       FontAttributes="Bold"
                       Margin="0,8,0,4"
                       TextColor="{DynamicResource TextPrimaryColor}"
                       SemanticProperties.HeadingLevel="Level2"/>

                <CollectionView ItemsSource="{Binding Recipe.Ingredients}"
                                SemanticProperties.Description="List of ingredients needed for this recipe">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <HorizontalStackLayout Spacing="8" Padding="4,6">
                                <Label Text="•"
                                       FontSize="16"
                                       TextColor="{DynamicResource PrimaryColor}"
                                       VerticalOptions="Center"/>
                                <Label Text="{Binding .}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       TextColor="{DynamicResource TextPrimaryColor}"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Steps Section -->
                <Label Text="Method"
                       FontSize="{DynamicResource FontSizeHeader}"
                       FontAttributes="Bold"
                       Margin="0,12,0,4"
                       TextColor="{DynamicResource TextPrimaryColor}"
                       SemanticProperties.HeadingLevel="Level2"/>

                <CollectionView ItemsSource="{Binding Recipe.Steps}"
                                SemanticProperties.Description="Step by step cooking instructions">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Frame Padding="12"
                                   Margin="0,4"
                                   CornerRadius="8"
                                   BackgroundColor="{DynamicResource CardBackgroundColor}"
                                   BorderColor="{DynamicResource BorderColor}">
                                <Label Text="{Binding .}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       TextColor="{DynamicResource TextPrimaryColor}"/>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <BoxView HeightRequest="20" Color="Transparent"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>