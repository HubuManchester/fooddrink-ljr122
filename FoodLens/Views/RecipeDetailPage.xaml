<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FoodLens.ViewModels"
             x:Class="FoodLens.Views.RecipeDetailPage"
             x:DataType="viewmodels:RecipeDetailViewModel"
             Title="{Binding Recipe.Name}"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}">

    <ScrollView>
        <VerticalStackLayout Spacing="12" Padding="16">

            <!-- Recipe Image -->
            <Frame Padding="0"
                   CornerRadius="16"
                   HasShadow="True"
                   IsClippedToBounds="True"
                   HeightRequest="220"
                   SemanticProperties.Description="{Binding Recipe.Name, StringFormat='Photo of {0}'}">
                <Image Source="{Binding Recipe.ImageUrl}"
                       Aspect="AspectFill"
                       HeightRequest="220"/>
            </Frame>

            <!-- Recipe Title and Origin -->
            <Label Text="{Binding Recipe.Name}"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                   SemanticProperties.HeadingLevel="Level1"
                   SemanticProperties.Description="{Binding Recipe.Name}"/>

            <Label Text="{Binding Recipe.Origin, StringFormat='📍 Origin: {0}'}"
                   FontSize="14"
                   TextColor="{StaticResource PrimaryColor}"
                   SemanticProperties.Description="{Binding Recipe.Origin, StringFormat='Recipe originates from {0}'}"/>

            <!-- Quick Info Cards -->
            <Grid ColumnDefinitions="*,*,*,*"
                  ColumnSpacing="8"
                  Margin="0,8">

                <Frame Grid.Column="0" Padding="8" CornerRadius="10"
                       BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#1B5E20}"
                       BorderColor="Transparent">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="⏱️" FontSize="20" HorizontalOptions="Center"/>
                        <Label Text="{Binding Recipe.PrepTimeMinutes, StringFormat='{0}m'}"
                               FontSize="12" HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                               SemanticProperties.Description="{Binding Recipe.PrepTimeMinutes, StringFormat='Preparation time {0} minutes'}"/>
                        <Label Text="Prep" FontSize="10" HorizontalOptions="Center" TextColor="Gray"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Column="1" Padding="8" CornerRadius="10"
                       BackgroundColor="{AppThemeBinding Light=#FFF3E0, Dark=#E65100}"
                       BorderColor="Transparent">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="🔥" FontSize="20" HorizontalOptions="Center"/>
                        <Label Text="{Binding Recipe.CookTimeMinutes, StringFormat='{0}m'}"
                               FontSize="12" HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                               SemanticProperties.Description="{Binding Recipe.CookTimeMinutes, StringFormat='Cooking time {0} minutes'}"/>
                        <Label Text="Cook" FontSize="10" HorizontalOptions="Center" TextColor="Gray"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Column="2" Padding="8" CornerRadius="10"
                       BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#0D47A1}"
                       BorderColor="Transparent">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="🍽️" FontSize="20" HorizontalOptions="Center"/>
                        <Label Text="{Binding Recipe.Servings, StringFormat='{0}'}"
                               FontSize="12" HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                               SemanticProperties.Description="{Binding Recipe.Servings, StringFormat='Serves {0} people'}"/>
                        <Label Text="Serves" FontSize="10" HorizontalOptions="Center" TextColor="Gray"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Column="3" Padding="8" CornerRadius="10"
                       BackgroundColor="{AppThemeBinding Light=#FCE4EC, Dark=#880E4F}"
                       BorderColor="Transparent">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="📊" FontSize="20" HorizontalOptions="Center"/>
                        <Label Text="{Binding Recipe.Difficulty}"
                               FontSize="12" HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                               SemanticProperties.Description="{Binding Recipe.Difficulty, StringFormat='Difficulty level is {0}'}"/>
                        <Label Text="Level" FontSize="10" HorizontalOptions="Center" TextColor="Gray"/>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Description -->
            <Label Text="{Binding Recipe.Description}"
                   FontSize="15"
                   TextColor="{AppThemeBinding Light=#424242, Dark=#BDBDBD}"
                   Margin="0,4"/>

            <!-- Action Buttons Row -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,8">

                <!-- Text-to-Speech Button (HARDWARE: TTS) -->
                <Button Grid.Column="0"
                        Text="{Binding SpeakButtonText}"
                        Command="{Binding ToggleSpeakStepsCommand}"
                        BackgroundColor="{StaticResource PrimaryColor}"
                        TextColor="White"
                        CornerRadius="10"
                        FontSize="12"
                        Padding="8,12"
                        SemanticProperties.Description="Read recipe steps aloud using text to speech"
                        SemanticProperties.Hint="Tap to hear the recipe steps read aloud"/>

                <!-- Map Button (HARDWARE: Geolocation) -->
                <Button Grid.Column="1"
                        Text="🗺️ Origin Map"
                        Command="{Binding OpenMapCommand}"
                        BackgroundColor="{StaticResource SecondaryColor}"
                        TextColor="White"
                        CornerRadius="10"
                        FontSize="12"
                        Padding="8,12"
                        SemanticProperties.Description="Open map showing recipe origin location"
                        SemanticProperties.Hint="Tap to see where this recipe comes from on a map"/>

                <!-- Share Button -->
                <Button Grid.Column="2"
                        Text="📤 Share"
                        Command="{Binding ShareRecipeCommand}"
                        BackgroundColor="#7B1FA2"
                        TextColor="White"
                        CornerRadius="10"
                        FontSize="12"
                        Padding="8,12"
                        SemanticProperties.Description="Share this recipe with others"
                        SemanticProperties.Hint="Tap to share this recipe via messaging or social media"/>
            </Grid>

            <!-- Nutrition Info Section -->
            <Frame Padding="12"
                   CornerRadius="12"
                   BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2C}"
                   BorderColor="Transparent"
                   Margin="0,4">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Nutrition (per serving)"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                           SemanticProperties.HeadingLevel="Level2"/>
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="8">
                        <Label Grid.Row="0" Grid.Column="0"
                               Text="{Binding Recipe.Nutrition.Calories, StringFormat='🔥 Calories: {0} kcal'}"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"/>
                        <Label Grid.Row="0" Grid.Column="1"
                               Text="{Binding Recipe.Nutrition.ProteinGrams, StringFormat='💪 Protein: {0:F1}g'}"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"/>
                        <Label Grid.Row="1" Grid.Column="0"
                               Text="{Binding Recipe.Nutrition.CarbsGrams, StringFormat='🌾 Carbs: {0:F1}g'}"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"/>
                        <Label Grid.Row="1" Grid.Column="1"
                               Text="{Binding Recipe.Nutrition.FatGrams, StringFormat='🧈 Fat: {0:F1}g'}"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"/>
                        <Label Grid.Row="2" Grid.Column="0"
                               Text="{Binding Recipe.Nutrition.FiberGrams, StringFormat='🥬 Fiber: {0:F1}g'}"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Ingredients Section -->
            <Label Text="Ingredients"
                   FontSize="18"
                   FontAttributes="Bold"
                   Margin="0,8,0,4"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                   SemanticProperties.HeadingLevel="Level2"/>

            <CollectionView ItemsSource="{Binding Recipe.Ingredients}"
                            SemanticProperties.Description="List of ingredients needed for this recipe">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <HorizontalStackLayout Spacing="8" Padding="4,6">
                            <Label Text="•"
                                   FontSize="16"
                                   TextColor="{StaticResource PrimaryColor}"
                                   VerticalOptions="Center"/>
                            <Label Text="{Binding .}"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Steps Section -->
            <Label Text="Method"
                   FontSize="18"
                   FontAttributes="Bold"
                   Margin="0,12,0,4"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                   SemanticProperties.HeadingLevel="Level2"/>

            <CollectionView ItemsSource="{Binding Recipe.Steps}"
                            SemanticProperties.Description="Step by step cooking instructions">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Frame Padding="12"
                               Margin="0,4"
                               CornerRadius="8"
                               BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#252525}"
                               BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}">
                            <Label Text="{Binding .}"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"/>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Bottom spacing -->
            <BoxView HeightRequest="20" Color="Transparent"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>