<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodLens.Views.MapPage"
             Title="Food Map">

    <Grid BackgroundColor="{DynamicResource PageBackgroundColor}">
        <VerticalStackLayout Spacing="12" Padding="16">

            <Label Text="Food Origins Map"
                   FontSize="{DynamicResource FontSizeTitle}"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{DynamicResource TextPrimaryColor}"
                   SemanticProperties.HeadingLevel="Level1"/>

            <Label Text="Discover where your favourite recipes come from around the world."
                   FontSize="{DynamicResource FontSizeBody}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   TextColor="{DynamicResource TextSecondaryColor}"/>

            <Frame Padding="16"
                   CornerRadius="12"
                   BackgroundColor="{DynamicResource InfoBackgroundColor}"
                   BorderColor="Transparent">
                <VerticalStackLayout Spacing="8">
                    <Label Text="📍 Your Current Location"
                           FontSize="{DynamicResource FontSizeSubtitle}"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimaryColor}"
                           SemanticProperties.HeadingLevel="Level2"/>
                    <Label x:Name="LocationLabel"
                           Text="Tap the button below to get your location"
                           FontSize="{DynamicResource FontSizeBody}"
                           TextColor="{DynamicResource TextPrimaryColor}"
                           SemanticProperties.Description="Your current geographic location"/>
                </VerticalStackLayout>
            </Frame>

            <Button Text="📍 Get My Location"
                    Clicked="OnGetLocationClicked"
                    BackgroundColor="{DynamicResource PrimaryColor}"
                    TextColor="{DynamicResource ButtonTextColor}"
                    CornerRadius="12"
                    FontSize="15"
                    HeightRequest="48"
                    SemanticProperties.Description="Get your current geographic location"
                    SemanticProperties.Hint="Uses GPS to determine your current position"/>

            <Label Text="Recipe Origins"
                   FontSize="{DynamicResource FontSizeHeader}"
                   FontAttributes="Bold"
                   Margin="0,12,0,4"
                   TextColor="{DynamicResource TextPrimaryColor}"
                   SemanticProperties.HeadingLevel="Level2"/>

            <CollectionView x:Name="OriginsCollection"
                            SemanticProperties.Description="List of recipe origins you can view on a map">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="12"
                               Margin="0,4"
                               CornerRadius="10"
                               BackgroundColor="{DynamicResource CardBackgroundColor}"
                               BorderColor="{DynamicResource BorderColor}">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Name}"
                                           FontSize="{DynamicResource FontSizeSubtitle}"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource TextPrimaryColor}"/>
                                    <Label Text="{Binding Origin}"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           TextColor="{DynamicResource PrimaryColor}"/>
                                </VerticalStackLayout>
                                <Button Grid.Column="1"
                                        Text="🗺️"
                                        FontSize="20"
                                        BackgroundColor="Transparent"
                                        Clicked="OnOpenMapClicked"
                                        CommandParameter="{Binding .}"
                                        SemanticProperties.Description="Open map for this recipe origin"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </Grid>
</ContentPage>